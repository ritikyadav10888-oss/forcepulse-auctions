# Copy to .env and fill in.
# SQLite file for local use. For PostgreSQL: set provider = "postgresql" in prisma/schema.prisma and use
# DATABASE_URL="postgresql://user:password@host:5432/forcepulse"
DATABASE_URL="file:./dev.db"

# Force Pulse admin account, created on first start
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Force Pulse Admin"

PORT=3000

# Signs password-reset links. Any long random string; keep it secret and the same across restarts.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public address of the app, used in password-reset emails (e.g. https://auctions.forcepulse.in)
APP_URL="http://localhost:3000"

# Email for "Forgot password". Until these are set, reset links are printed in the server console instead.
# Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=465, SMTP_USER=your Gmail, SMTP_PASS=a Google "App password"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Force Pulse <no-reply@example.com>"

# Production only: "false" allows sign-in over plain http (server reached by IP, before a domain + SSL is set up)
COOKIE_SECURE="true"

# Optional: also copy daily backups to this Cloud Storage bucket (see deploy/README.md)
BACKUP_BUCKET=""
